CREATE DATABASE laplomada-database;

USE laplomada-database;

CREATE TABLE Categoria
(
  id_Categoria INT INDENTITY(1, 1) NOT NULL,
  nombre_categoria VARCHAR(100) NOT NULL,
  PRIMARY KEY (id_Categoria)
);
